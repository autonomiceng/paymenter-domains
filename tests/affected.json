{
  "_doc": "Change-to-test map for scripts/affected.py. Tests within `depth` hops of a changed file are affected. A `core` file, or one that reaches more than a quarter of all tests within two hops, widens the slice; `explicit` adds tests no file reference finds; `no_tests` files never reach tests.",
  "scan": ["Domains", "tests", "scripts"],
  "covers": ["*"],
  "depth": 1,
  "core": [
    "scripts/test.py",
    "scripts/test_workers.py",
    "tests/native-database.php",
    "scripts/php-test",
    "tests/suites.json",
    "Domains/routes/*",
    "Domains/database/migrations/*",
    "composer.json",
    "composer.lock"
  ],
  "explicit": {
    "Domains/Services/HoldingLocks.php": ["tests/cli-renewal-resume-proof-test.php"],
    "Domains/Services/RegistrarCheck.php": ["tests/cli-renewal-resume-proof-test.php", "tests/cli-renewal-concurrent-proof-test.php"],
    "Domains/Services/InvoiceMoney.php": ["tests/cli-complimentary-external-refund-test.php"],
    "Domains/Services/RegistrarAnswers.php": [
      "tests/renewal-answer-fresh-expiry-test.php",
      "tests/renewal-answer-retained-proof-test.php",
      "tests/renewal-history-deadline-proof-test.php",
      "tests/cli-renewal-resume-proof-test.php",
      "tests/renewal-check-claim-test.php",
      "tests/cli-renewal-concurrent-proof-test.php"
    ],
    "Domains/Registrars/Enom/History.php": ["tests/renewal-history-deadline-proof-test.php"],
    "Domains/Services/NativeDomainGuard.php": ["tests/complimentary-acquisition-receipt-test.php", "tests/complimentary-departed-receipt-test.php", "tests/complimentary-departed-owner-credit-test.php", "tests/complimentary-receipt-repair-test.php", "tests/cli-complimentary-external-refund-test.php"],
    "Domains/Services/Refunds.php": ["tests/complimentary-acquisition-receipt-test.php", "tests/complimentary-departed-receipt-test.php", "tests/complimentary-departed-owner-credit-test.php", "tests/complimentary-receipt-repair-test.php", "tests/complimentary-refunded-receipt-test.php", "tests/cli-complimentary-external-refund-test.php"],
    "Domains/Services/ComplimentaryInvoices.php": ["tests/complimentary-refunded-receipt-test.php", "tests/cli-complimentary-external-refund-test.php"],
    "Domains/Services/RenewalCompletion.php": ["tests/renewal-resume-race-proof-test.php", "tests/cli-renewal-resume-proof-test.php", "tests/renewal-check-claim-test.php", "tests/cli-renewal-concurrent-proof-test.php"],
    "Domains/Services/HoldingDeparture.php": ["tests/complimentary-departed-receipt-test.php", "tests/complimentary-departed-owner-credit-test.php"],
    "tests/Support/staff-tld-filter-lookalikes.php": ["tests/staff-tld-page-test.php"],
    "tests/Support/enom-renewal-*-cases.php": ["tests/test_installed_package_enom_renewal.py"],
    "tests/Support/enom-registration-contracts-cases.php": ["tests/test_installed_package_enom_test.py"],
    "tests/Support/enom-transfer-cases-fixture.php": ["tests/test_installed_package_enom_transfer.py"],
    "tests/Support/runtime-enom-*.php": ["tests/test_installed_package_enom_exchange.py"],
    "Domains/database/migrations/*": [
      "tests/test_installed_package_fresh.py",
      "tests/test_installed_package_upgrade.py",
      "tests/test_schema_mariadb.py"
    ],
    "Domains/Services/RenewalCycles.php": ["tests/cancelled-renewal-payment-test.php", "tests/late-renewal-test.php"],
    "Domains/routes/*": ["tests/test_installed_package.py"],
    "Domains/*.php": ["tests/test_installed_package.py"],
    "tests/suites.json": ["tests/test_runner.py"],
    "scripts/test.py": ["tests/test_runner.py"],
    "scripts/test_workers.py": ["tests/test_runner.py"],
    "tests/native-database.php": ["tests/test_runner.py"],
    "scripts/php-test": ["tests/test_runner.py"]
  },
  "no_tests": ["*.md", "LICENSE", "*.png", "*.svg", "tests/enom-answer-render.php", "tests/staff-watch-render.php", "tests/Support/request-review-render.php", "tests/Support/billing-hold-render.php", "tests/Support/request-order-unproven-render.php"]
}
